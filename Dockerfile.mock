FROM python:3.11-slim

WORKDIR /app

# System dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy project structure
COPY requirements.txt ./
# Install all required packages for mock demo
RUN pip install --no-cache-dir -r requirements.txt

# In a real scenario we'd copy each service's requirements, but for the mock demo 
# we've installed Streamlit and Boto3 which are the main dependencies for the UI and AWS mocks.

# Copy the actual code
COPY . .

# Environment Variables
ENV MOCK_MODE=1
ENV BEDROCK_MODEL_ID=mock-model

EXPOSE 8501

HEALTHCHECK CMD curl --fail http://localhost:8501/_stcore/health

ENTRYPOINT ["streamlit", "run", "mock_demo.py", "--server.port=8501", "--server.address=0.0.0.0"]
